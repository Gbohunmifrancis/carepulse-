{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "workstation id=portfolio.mssql.somee.com;packet size=4096;user id=jimolsen_SQLLogin_1;pwd=n42xf1r3bo;data source=portfolio.mssql.somee.com;persist security info=False;initial catalog=portfolio;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast256BitsLong!",
    "Issuer": "PharmacySystem",
    "Audience": "PharmacySystemUsers",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
